{
  "manifest_version": 3,
  "name": "Magpie",
  "version": "1.0.0",
  "description": "Save posts from Instagram and X to your own private archive — without triggering any platform interaction.",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "Magpie",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "dist/content-scripts/instagram.js"
      ],
      "css": [
        "dist/styles/toast.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "dist/content-scripts/x.js"
      ],
      "css": [
        "dist/styles/toast.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/styles/toast.css",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
