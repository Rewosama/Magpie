# Supabase Project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous (public) Key
# Found in: Supabase Dashboard → Project Settings → API → anon public
# Safe to expose — RLS policies protect your data
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: override the Edge Functions base URL
# Default: SUPABASE_URL/functions/v1
# SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# URL of the Magpie web viewer
WEB_VIEWER_URL=http://localhost:3001
