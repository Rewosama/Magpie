# Supabase project URL — found in your Supabase dashboard under Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) key — found in your Supabase dashboard under Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NOT required for normal operation.
# Only needed if you add custom server-side admin operations.
# SUPABASE_SERVICE_ROLE_KEY=
